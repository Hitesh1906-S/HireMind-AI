# ==============================================================================
# HireMind AI - Production Environment Template (.env.production)
# ==============================================================================

# Core Application Runtime
NODE_ENV=production
PORT=5001

# PostgreSQL High-Availability Database Connection
# Recommendation: Use connection pooling (PgBouncer or Supabase Transaction Pooler)
DATABASE_URL="postgresql://hiremind_user:CHANGE_ME_STRONG_PASSWORD@db.example.com:5432/hiremind_prod?sslmode=require&pool_timeout=15"

# Cryptographic Keys (Generate with: openssl rand -base64 32)
JWT_ACCESS_SECRET="CHANGE_ME_TO_A_CRYPTOGRAPHICALLY_SECURE_RANDOM_BASE64_KEY_1"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_SECRET="CHANGE_ME_TO_A_CRYPTOGRAPHICALLY_SECURE_RANDOM_BASE64_KEY_2"
JWT_REFRESH_EXPIRES_IN="7d"
JWT_RESET_PASSWORD_SECRET="CHANGE_ME_TO_A_CRYPTOGRAPHICALLY_SECURE_RANDOM_BASE64_KEY_3"
JWT_RESET_PASSWORD_EXPIRES_IN="1h"

# Domain & CORS Allowlist
# Production origin without trailing slash
CORS_ORIGIN="https://hiremind.yourdomain.com"
APP_URL="https://hiremind.yourdomain.com"
NEXT_PUBLIC_API_URL="https://api.hiremind.yourdomain.com"

# Google Gemini AI Inference Engine
# Required for CV parsing, live coding assessment, and technical interview synthesis
GEMINI_API_KEY="AIzaSy_YOUR_PRODUCTION_GEMINI_API_KEY_HERE"
AI_PROVIDER="gemini"
AI_MODEL="gemini-1.5-flash"
STT_PROVIDER="gemini"

# Email Delivery Provider (Recommended: 'resend', 'sendgrid', or 'smtp')
EMAIL_PROVIDER="resend"
EMAIL_FROM="HireMind AI <notifications@yourverifieddomain.com>"

# Provider API Keys
RESEND_API_KEY="re_1234567890abcdef"
# SENDGRID_API_KEY="SG.1234567890"

# Optional SMTP Settings
# SMTP_HOST="smtp.mailgun.org"
# SMTP_PORT=587
# SMTP_USER="postmaster@yourdomain.com"
# SMTP_PASS="your_smtp_password"
# SMTP_SECURE=false
