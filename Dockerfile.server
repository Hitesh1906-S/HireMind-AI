# Stage 1: Build
FROM node:20-alpine AS builder

WORKDIR /app

# Install build dependencies
RUN apk add --no-cache python3 make g++

# Copy workspace package manifests
COPY package.json package-lock.json ./
COPY server/package.json ./server/
COPY client/package.json ./client/

# Install root & workspace dependencies
RUN npm ci

# Copy server source code and prisma schema
COPY server/prisma ./server/prisma
COPY server/tsconfig.json ./server/
COPY server/src ./server/src

# Generate Prisma Client and compile TypeScript
RUN npm run db:generate --workspace=server
RUN npm run build:server

# Stage 2: Production Runner
FROM node:20-alpine AS runner

WORKDIR /app

ENV NODE_ENV=production
ENV PORT=5001

RUN apk add --no-cache curl

# Create non-root user
RUN addgroup --system --gid 1001 nodejs && \
    adduser --system --uid 1001 hiremind

# Copy package manifests and production dependencies
COPY package.json package-lock.json ./
COPY server/package.json ./server/
COPY client/package.json ./client/

RUN npm ci --omit=dev

# Copy compiled files and prisma artifacts
COPY --from=builder /app/server/dist ./server/dist
COPY --from=builder /app/server/prisma ./server/prisma
COPY --from=builder /app/node_modules/@prisma ./node_modules/@prisma
COPY --from=builder /app/node_modules/.prisma ./node_modules/.prisma

# Create secure uploads directory
RUN mkdir -p /app/server/storage_secure && chown -R hiremind:nodejs /app

USER hiremind

EXPOSE 5001

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD curl -f http://localhost:5001/health || exit 1

WORKDIR /app/server
CMD ["node", "dist/server.js"]
