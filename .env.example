# ==============================================================================
# HireMind AI - Root Monorepo Environment Template
# ==============================================================================

# Server Runtime
PORT=5001
NODE_ENV=development

# Database Connection (PostgreSQL 15+)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/hiremind_db?schema=public"

# Authentication & JWT Secrets
JWT_ACCESS_SECRET="hiremind_dev_jwt_access_secret_key_minimum_32_chars_ok"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_SECRET="hiremind_dev_jwt_refresh_secret_key_minimum_32_chars_ok"
JWT_REFRESH_EXPIRES_IN="7d"
JWT_RESET_PASSWORD_SECRET="hiremind_dev_jwt_reset_secret_key_minimum_32_chars_ok"
JWT_RESET_PASSWORD_EXPIRES_IN="1h"

# Application URLs & CORS
CORS_ORIGIN="http://localhost:3000"
APP_URL="http://localhost:3000"
NEXT_PUBLIC_API_URL="http://localhost:5001"

# AI Integrations
GEMINI_API_KEY=""
AI_PROVIDER="gemini"
AI_MODEL="gemini-1.5-flash"
STT_PROVIDER="mock"

# Notification & Email Subsystem
EMAIL_PROVIDER="console"
EMAIL_FROM="HireMind AI <no-reply@hiremind.ai>"
