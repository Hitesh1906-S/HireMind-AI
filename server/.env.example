# ==============================================================================
# HireMind AI - Server Environment Variables (Development & Production Reference)
# ==============================================================================

# Application Runtime
PORT=5001
NODE_ENV=development

# Database Connection (PostgreSQL)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/hiremind_db?schema=public"

# Security & JWT Tokens (Must be minimum 16-32 characters of high-entropy strings in production)
JWT_ACCESS_SECRET="replace_with_high_entropy_32_character_jwt_access_secret_key"
JWT_ACCESS_EXPIRES_IN="15m"

JWT_REFRESH_SECRET="replace_with_high_entropy_32_character_jwt_refresh_secret_key"
JWT_REFRESH_EXPIRES_IN="7d"

JWT_RESET_PASSWORD_SECRET="replace_with_high_entropy_32_character_jwt_reset_secret_key"
JWT_RESET_PASSWORD_EXPIRES_IN="1h"

# Network & Cross-Origin Resource Sharing (CORS)
CORS_ORIGIN="http://localhost:3000"
APP_URL="http://localhost:3000"

# AI Evaluation Engine (Google Gemini 1.5 Flash / Pro)
GEMINI_API_KEY=""
AI_PROVIDER="gemini" # 'gemini' | 'mock'
AI_MODEL="gemini-1.5-flash"

# Speech-To-Text & Code Execution Providers
STT_PROVIDER="gemini" # 'gemini' | 'whisper' | 'mock'
CODE_EXECUTION_PROVIDER="mock" # 'mock' | 'docker_isolated'

# Transactional Email Service
EMAIL_PROVIDER="console" # 'console' | 'smtp' | 'sendgrid' | 'resend' | 'mock'
EMAIL_FROM="HireMind AI <no-reply@hiremind.ai>"

# SMTP Provider Options (Required only if EMAIL_PROVIDER=smtp)
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
SMTP_SECURE=false

# SendGrid Options (Required only if EMAIL_PROVIDER=sendgrid)
SENDGRID_API_KEY=""

# Resend Options (Required only if EMAIL_PROVIDER=resend)
RESEND_API_KEY=""
