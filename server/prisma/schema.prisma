generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum UserRole {
  CANDIDATE
  RECRUITER
  ADMIN
}

enum JobStatus {
  DRAFT
  ACTIVE
  PAUSED
  CLOSED
}

enum JobExperienceLevel {
  ENTRY
  MID
  SENIOR
  LEAD
  EXECUTIVE
}

enum JobEmploymentType {
  FULL_TIME
  PART_TIME
  CONTRACT
  INTERNSHIP
  REMOTE
}

enum ApplicationStatus {
  APPLIED
  SCREENING
  SHORTLISTED
  INTERVIEW
  SELECTED
  REJECTED
}

enum InterviewStatus {
  SCHEDULED
  READY
  IN_PROGRESS
  COMPLETED
  CANCELLED
  EXPIRED
}

enum InterviewType {
  TECHNICAL
  BEHAVIORAL
  CODING
  MIXED
  SYSTEM_DESIGN
  LIVE_CODING
  AI_SCREENING
}

enum InterviewDifficulty {
  EASY
  MEDIUM
  HARD
}

enum TestDifficulty {
  EASY
  MEDIUM
  HARD
}

enum TestStatus {
  ASSIGNED
  IN_PROGRESS
  SUBMITTED
  GRADED
}

enum MatchRecommendation {
  STRONG_MATCH
  GOOD_MATCH
  PARTIAL_MATCH
  WEAK_MATCH
}

model User {
  id           String      @id @default(uuid())
  name         String
  email        String      @unique
  passwordHash String
  role         UserRole    @default(CANDIDATE)
  avatar       String?
  bio          String?
  headline     String?
  phone        String?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  refreshTokens          RefreshToken[]
  passwordResetTokens    PasswordResetToken[]
  postedJobs             Job[]                 @relation("RecruiterJobs")
  applications           Application[]         @relation("CandidateApplications")
  candidateInterviews    Interview[]           @relation("CandidateInterviews")
  recruiterInterviews    Interview[]           @relation("RecruiterInterviews")
  assignedTests          CodingTest[]          @relation("CandidateTests")
  assessmentResults      AssessmentResult[]    @relation("CandidateResults")
  conductedEvaluations   AssessmentResult[]    @relation("EvaluatorResults")
  notifications          Notification[]
  resumes                Resume[]              @relation("CandidateResumes")
  candidateProfile       CandidateProfile?     @relation("UserProfile")
  jobMatches             JobMatchAnalysis[]    @relation("CandidateJobMatches")
  interviewSessions      InterviewSession[]    @relation("CandidateInterviewSessions")
  interviewResponses     InterviewResponse[]   @relation("CandidateInterviewResponses")
  interviewEvaluations   InterviewEvaluation[] @relation("EvaluatorInterviewEvaluations")
  codingSubmissions      CodingSubmission[]    @relation("CandidateCodingSubmissions")

  @@map("users")
}

model RefreshToken {
  id        String   @id @default(uuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  revoked   Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId])
  @@map("refresh_tokens")
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  tokenHash String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@map("password_reset_tokens")
}

model Job {
  id                  String             @id @default(uuid())
  title               String
  department          String
  description         String
  responsibilities    String
  requiredSkills      String[]
  preferredSkills     String[]
  experienceLevel     JobExperienceLevel @default(MID)
  location            String
  employmentType      JobEmploymentType  @default(FULL_TIME)
  salaryRange         String?
  status              JobStatus          @default(ACTIVE)
  applicationDeadline DateTime?
  recruiterId         String
  recruiter           User               @relation("RecruiterJobs", fields: [recruiterId], references: [id], onDelete: Cascade)
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  applications        Application[]
  interviews          Interview[]
  codingTests         CodingTest[]
  matchAnalyses       JobMatchAnalysis[]

  @@index([recruiterId])
  @@index([status])
  @@index([department])
  @@map("jobs")
}

model Application {
  id          String            @id @default(uuid())
  jobId       String
  job         Job               @relation(fields: [jobId], references: [id], onDelete: Cascade)
  candidateId String
  candidate   User              @relation("CandidateApplications", fields: [candidateId], references: [id], onDelete: Cascade)
  status      ApplicationStatus @default(APPLIED)
  resumeUrl   String?
  resumeId    String?
  resume      Resume?           @relation(fields: [resumeId], references: [id], onDelete: SetNull)
  coverLetter String?
  matchScore  Float?
  matchAnalysis Json?
  notes       String?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  interviews         Interview[]
  assessmentResults  AssessmentResult[]
  jobMatches         JobMatchAnalysis[]

  @@unique([jobId, candidateId])
  @@index([jobId])
  @@index([candidateId])
  @@index([resumeId])
  @@index([status])
  @@map("applications")
}

model Resume {
  id            String             @id @default(uuid())
  candidateId   String
  candidate     User               @relation("CandidateResumes", fields: [candidateId], references: [id], onDelete: Cascade)
  fileName      String
  storageKey    String
  fileSize      Int
  mimeType      String             @default("application/pdf")
  version       Int                @default(1)
  isPrimary     Boolean            @default(false)
  parsingStatus String             @default("PENDING") // PENDING, PROCESSING, COMPLETED, FAILED
  parsingError  String?
  parsedData    Json?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  applications      Application[]
  candidateProfiles CandidateProfile[] @relation("ResumeProfiles")
  matchAnalyses     JobMatchAnalysis[]

  @@index([candidateId])
  @@index([candidateId, isPrimary])
  @@map("resumes")
}

model CandidateProfile {
  id                String            @id @default(uuid())
  userId            String            @unique
  user              User              @relation("UserProfile", fields: [userId], references: [id], onDelete: Cascade)
  rawResumeId       String?
  rawResume         Resume?           @relation("ResumeProfiles", fields: [rawResumeId], references: [id], onDelete: SetNull)
  fullName          String?
  email             String?
  phone             String?
  location          String?
  headline          String?
  summary           String?
  yearsOfExperience Float             @default(0)
  certifications    String[]          @default([])
  achievements      String[]          @default([])
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  workExperiences   WorkExperience[]
  educations        EducationRecord[]
  skills            CandidateSkill[]
  projects          CandidateProject[]

  @@index([userId])
  @@map("candidate_profiles")
}

model WorkExperience {
  id           String           @id @default(uuid())
  profileId    String
  profile      CandidateProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  company      String
  position     String
  startDate    String?
  endDate      String?
  isCurrent    Boolean          @default(false)
  description  String?
  technologies String[]         @default([])
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  @@index([profileId])
  @@map("work_experiences")
}

model EducationRecord {
  id           String           @id @default(uuid())
  profileId    String
  profile      CandidateProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  institution  String
  degree       String
  fieldOfStudy String?
  startDate    String?
  endDate      String?
  grade        String?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  @@index([profileId])
  @@map("education_records")
}

model CandidateSkill {
  id        String           @id @default(uuid())
  profileId String
  profile   CandidateProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  name      String
  category  String           @default("OTHER") // LANGUAGE, FRAMEWORK, DATABASE, TOOL, OTHER
  createdAt DateTime         @default(now())

  @@index([profileId])
  @@index([name])
  @@map("candidate_skills")
}

model CandidateProject {
  id           String           @id @default(uuid())
  profileId    String
  profile      CandidateProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  title        String
  description  String?
  technologies String[]         @default([])
  url          String?
  highlights   String[]         @default([])
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  @@index([profileId])
  @@map("candidate_projects")
}

model Interview {
  id            String              @id @default(uuid())
  title         String
  type          InterviewType       @default(TECHNICAL)
  status        InterviewStatus     @default(SCHEDULED)
  difficulty    InterviewDifficulty @default(MEDIUM)
  scheduledAt   DateTime
  durationMins  Int                 @default(60)
  numQuestions  Int                 @default(5)
  meetingLink   String?
  chamberRoomId String?
  notes         String?

  jobId         String
  job           Job                 @relation(fields: [jobId], references: [id], onDelete: Cascade)
  candidateId   String
  candidate     User                @relation("CandidateInterviews", fields: [candidateId], references: [id], onDelete: Cascade)
  recruiterId   String
  recruiter     User                @relation("RecruiterInterviews", fields: [recruiterId], references: [id], onDelete: Cascade)
  applicationId String?
  application   Application?        @relation(fields: [applicationId], references: [id], onDelete: SetNull)

  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  questions         InterviewQuestion[]
  session           InterviewSession?
  responses         InterviewResponse[]
  evaluation        InterviewEvaluation?
  codingQuestions   CodingQuestion[]
  codingSubmissions CodingSubmission[]
  proctoringEvents  ProctoringEvent[]

  @@index([candidateId])
  @@index([recruiterId])
  @@index([jobId])
  @@index([status])
  @@map("interviews")
}

model InterviewQuestion {
  id                 String              @id @default(uuid())
  interviewId        String
  interview          Interview           @relation(fields: [interviewId], references: [id], onDelete: Cascade)
  orderIndex         Int                 @default(1)
  title              String
  description        String              // question text
  type               String              @default("TECHNICAL") // TECHNICAL, BEHAVIORAL, CODING, SYSTEM_DESIGN
  difficulty         InterviewDifficulty @default(MEDIUM)
  category           String              @default("Technical") // Fundamentals, Technical, Scenario-based, Problem-solving, Project-based, Behavioral
  expectedTopics     String[]            @default([])
  evaluationCriteria String[]            @default([])
  isAiGenerated      Boolean             @default(true)
  starterCode        String?
  testCases          Json?               // [{ input, expectedOutput, description }]
  expectedOutput     String?
  rubricCriteria     Json?               // key evaluation concepts
  timeLimitMins      Int?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  responses          InterviewResponse[]

  @@index([interviewId])
  @@index([orderIndex])
  @@map("interview_questions")
}

model InterviewSession {
  id                   String          @id @default(uuid())
  interviewId          String          @unique
  interview            Interview       @relation(fields: [interviewId], references: [id], onDelete: Cascade)
  candidateId          String
  candidate            User            @relation("CandidateInterviewSessions", fields: [candidateId], references: [id], onDelete: Cascade)

  status               InterviewStatus @default(SCHEDULED)
  currentQuestionIndex Int             @default(0)
  startedAt            DateTime?
  resumedAt            DateTime?
  expiresAt            DateTime?
  completedAt          DateTime?
  timeRemainingSeconds Int?
  lastActiveAt         DateTime        @default(now())
  clientState          Json?           // draft buffers, code snippets, notes surviving page refreshes
  proctorLogs          Json?           // network/window events

  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt

  @@index([interviewId])
  @@index([candidateId])
  @@index([status])
  @@map("interview_sessions")
}

model InterviewResponse {
  id               String            @id @default(uuid())
  interviewId      String
  interview        Interview         @relation(fields: [interviewId], references: [id], onDelete: Cascade)
  questionId       String
  question         InterviewQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  candidateId      String
  candidate        User              @relation("CandidateInterviewResponses", fields: [candidateId], references: [id], onDelete: Cascade)

  answerText       String?           // verbal / written response
  codeAnswer       String?           // code solution
  codeLanguage     String?           @default("typescript")
  executionResults Json?             // test runs / output
  timeSpentSeconds Int               @default(0)
  isSubmitted      Boolean           @default(false)
  submittedAt      DateTime?

  // Voice & Communication Metrics
  audioUrl                  String?
  transcript                String?           @db.Text
  speakingDurationSeconds   Float             @default(0)
  fillerWordCount           Int               @default(0)
  fillerWords               Json?             @default("[]")
  answerRelevanceScore      Float?
  responseCompletenessScore Float?
  communicationMetrics      Json?
  aiFeedback                Json?

  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  @@unique([interviewId, questionId])
  @@index([interviewId])
  @@index([questionId])
  @@index([candidateId])
  @@map("interview_responses")
}

model InterviewEvaluation {
  id                        String       @id @default(uuid())
  interviewId               String       @unique
  interview                 Interview    @relation(fields: [interviewId], references: [id], onDelete: Cascade)
  evaluatorId               String?
  evaluator                 User?        @relation("EvaluatorInterviewEvaluations", fields: [evaluatorId], references: [id], onDelete: SetNull)

  // 7 Core Scoring Dimensions (0 - 100)
  overallScore              Float        // Interview Performance
  technicalScore            Float        @default(0) // Technical Knowledge
  problemSolvingScore       Float        @default(0) // Problem Solving
  codingScore               Float        @default(0) // Coding Performance
  codeQualityScore          Float        @default(0) // Backward-compatible alias
  communicationScore        Float        @default(0) // Communication
  answerRelevanceScore      Float        @default(0) // Answer Relevance
  skillAlignmentScore       Float        @default(0) // Job Skill Alignment

  // AI Recommendation (STRONG_HIRE, HIRE, MAYBE, NO_HIRE)
  recommendation            String       @default("MAYBE")
  summary                   String       @default("")

  // Categorized AI Narrative Feedback
  strengths                 String[]     @default([])
  weaknesses                String[]     @default([])
  missingSkills             String[]     @default([])
  technicalSummary          String       @default("")
  communicationSummary       String       @default("")
  improvementAreas          String[]     @default([])
  growthAreas               String[]     @default([]) // Backward-compatible alias
  rubricBreakdown           Json?
  notes                     String?

  // Recruiter Manual Overrides & Decision Support
  recruiterRecommendation   String?      // Optional recruiter override
  recruiterNotes            String?      // Recruiter's personal evaluation notes
  isOverridden              Boolean      @default(false)
  overriddenAt              DateTime?
  overriddenById            String?
  decisionSupportDisclaimer String       @default("This evaluation is an AI-assisted decision-support summary designed to assist human recruiters. It does not constitute an automated hiring decision.")

  createdAt                 DateTime     @default(now())
  updatedAt                 DateTime     @updatedAt

  @@index([interviewId])
  @@index([evaluatorId])
  @@map("interview_evaluations")
}

model CodingTest {
  id              String         @id @default(uuid())
  title           String
  description     String
  difficulty      TestDifficulty @default(MEDIUM)
  durationMinutes Int            @default(45)
  category        String
  status          TestStatus     @default(ASSIGNED)
  score           Float?
  passingScore    Float          @default(70.0)
  starterCode     String?
  testCasesCount  Int            @default(5)
  deadline        DateTime?

  candidateId     String
  candidate       User           @relation("CandidateTests", fields: [candidateId], references: [id], onDelete: Cascade)
  jobId           String?
  job             Job?           @relation(fields: [jobId], references: [id], onDelete: SetNull)

  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([candidateId])
  @@index([status])
  @@map("coding_tests")
}

model AssessmentResult {
  id                 String       @id @default(uuid())
  overallScore       Float
  complexityScore    Float        @default(80.0)
  modularityScore    Float        @default(80.0)
  systemDesignScore  Float        @default(80.0)
  rubricSummary      String
  interviewerNotes   String?
  recommendation     String       @default("STRONG_HIRE")

  candidateId        String
  candidate          User         @relation("CandidateResults", fields: [candidateId], references: [id], onDelete: Cascade)
  evaluatorId        String
  evaluator          User         @relation("EvaluatorResults", fields: [evaluatorId], references: [id], onDelete: Cascade)
  applicationId      String?
  application        Application? @relation(fields: [applicationId], references: [id], onDelete: SetNull)

  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  @@index([candidateId])
  @@index([evaluatorId])
  @@map("assessment_results")
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  message   String
  type      String   @default("INFO") // INFO, SUCCESS, WARNING, INTERVIEW, APPLICATION, etc.
  read      Boolean  @default(false)
  link      String?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([read])
  @@map("notifications")
}

model JobMatchAnalysis {
  id                  String              @id @default(uuid())
  jobId               String
  job                 Job                 @relation(fields: [jobId], references: [id], onDelete: Cascade)
  candidateId         String
  candidate           User                @relation("CandidateJobMatches", fields: [candidateId], references: [id], onDelete: Cascade)
  resumeId            String?
  resume              Resume?             @relation(fields: [resumeId], references: [id], onDelete: SetNull)
  applicationId       String?
  application         Application?        @relation(fields: [applicationId], references: [id], onDelete: SetNull)

  overallScore        Float               // 0 - 100
  requiredSkillScore  Float               @default(0) // 0 - 100
  preferredSkillScore Float               @default(0) // 0 - 100
  experienceScore     Float               @default(0) // 0 - 100
  educationScore      Float               @default(0) // 0 - 100
  projectScore        Float               @default(0) // 0 - 100

  matchedSkills       String[]            @default([])
  missingSkills       String[]            @default([])
  strengths           String[]            @default([])
  weaknesses          String[]            @default([])
  experienceMatch     Json                // { score: number, summary: string }
  recommendation      MatchRecommendation @default(PARTIAL_MATCH)
  summary             String              @default("")
  scoringBreakdown    Json?               // detailed metrics & weights

  isAIGenerated       Boolean             @default(true)
  modelName           String?             @default("gemini-1.5-flash")
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  @@unique([jobId, candidateId])
  @@index([jobId])
  @@index([candidateId])
  @@index([overallScore])
  @@map("job_match_analyses")
}

model CodingQuestion {
  id                 String              @id @default(uuid())
  interviewId        String?
  interview          Interview?          @relation(fields: [interviewId], references: [id], onDelete: SetNull)
  title              String
  description        String              // Detailed Markdown description / problem statement
  difficulty         InterviewDifficulty @default(MEDIUM)
  constraints        String[]            @default([])
  examples           Json?               // [{ input, output, explanation }]
  testCases          Json?               // [{ id, input, expectedOutput, isHidden, description }]
  starterCode        Json?               // { javascript: string, python: string, cpp: string, java: string }
  supportedLanguages String[]            @default(["javascript", "python", "cpp", "java"])
  category           String              @default("Algorithms")
  timeLimitMins      Int                 @default(30)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  submissions        CodingSubmission[]

  @@index([interviewId])
  @@index([difficulty])
  @@map("coding_questions")
}

model CodingSubmission {
  id               String          @id @default(uuid())
  candidateId      String
  candidate        User            @relation("CandidateCodingSubmissions", fields: [candidateId], references: [id], onDelete: Cascade)
  interviewId      String?
  interview        Interview?      @relation(fields: [interviewId], references: [id], onDelete: SetNull)
  questionId       String
  question         CodingQuestion  @relation(fields: [questionId], references: [id], onDelete: Cascade)

  language         String          // javascript, python, cpp, java
  code             String          // Full solution code
  status           String          @default("SUBMITTED") // ACCEPTED, WRONG_ANSWER, TIME_LIMIT_EXCEEDED, COMPILATION_ERROR, RUNTIME_ERROR
  testResults      Json?           // [{ testCaseIndex, passed, input, expectedOutput, actualOutput, executionTimeMs, error }]
  passedTests      Int             @default(0)
  totalTests       Int             @default(0)
  executionTime    Float           @default(0) // ms
  memoryUsage      Float?          // KB / MB
  submittedAt      DateTime        @default(now())
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  @@index([candidateId])
  @@index([interviewId])
  @@index([questionId])
  @@index([status])
  @@map("coding_submissions")
}

model ProctoringEvent {
  id          String    @id @default(uuid())
  interviewId String
  interview   Interview @relation(fields: [interviewId], references: [id], onDelete: Cascade)
  eventType   String    // NO_FACE_DETECTED, MULTIPLE_FACES, LOOKING_AWAY, CAMERA_DISCONNECTED, TAB_HIDDEN, FULLSCREEN_EXIT
  timestamp   DateTime  @default(now())
  durationMs  Int?      // duration of event in milliseconds if applicable
  metadata    Json?     // { confidence, faceCount, gazeDirection, resolution, userAgent }
  createdAt   DateTime  @default(now())

  @@index([interviewId])
  @@index([eventType])
  @@index([timestamp])
  @@map("proctoring_events")
}



